// Schema Prisma - Sistema de Gestión Empresarial (Empresa Eléctrica)
// Fase 1: Usuarios/roles, marcación de horas, proyectos/actividades, evidencias fotográficas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  // Por encima de todos: mismo acceso que ADMINISTRADOR en todo lo
  // existente, mas la seccion de gestion de permisos (ver docs del modulo
  // correspondiente). No existia hasta la reestructuracion de roles.
  GERENTE
  // @map("JEFE") a proposito: el valor ya guardado en la base de datos de
  // produccion sigue siendo literalmente "JEFE" (evita una migracion de
  // datos), solo el nombre visible en el codigo/TypeScript cambia a
  // ADMINISTRADOR. Mismos permisos de siempre, ahora tambien compartidos
  // por GERENTE en todo lo existente (ver auditoria en cada modulo).
  ADMINISTRADOR    @map("JEFE")
  SUPERVISOR
  TRABAJADOR_CAMPO
  // Administra inventario (herramientas/materiales) — no es un rol de
  // gestion de proyectos, no se solapa con isManagerRole/MANAGERS.
  MERCADERISTA
}

enum InventoryItemType {
  HERRAMIENTA
  MATERIAL
}

enum MaterialRequestStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  ENTREGADA
}

enum ToolIncidentType {
  DANIO
  PERDIDA
}

enum VehicleStatus {
  ACTIVO
  MANTENIMIENTO
  INACTIVO
}

enum VehicleIncidentType {
  DANIO
  MANTENIMIENTO
  REPARACION
}

enum ProjectStatus {
  PLANIFICADO
  EN_PROGRESO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum ActivityStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
  // Distinta de CANCELADA: OMITIDA implica que hay que reprogramarla (sigue
  // haciendo falta), CANCELADA implica que ya no se necesita.
  OMITIDA
}

enum EvidenceStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Para que el cliente sepa como renderizar un archivo subido (imagen vs
// video, ej. Evidence.imageUrl o Activity.referenceImageUrl) sin adivinar
// por la extension de la URL de Cloudinary. Nullable en ambos usos: filas
// sembradas antes de esta migracion no lo tienen — el cliente cae a IMAGEN
// cuando es null (todo lo subido antes de este cambio era foto).
enum MediaType {
  IMAGEN
  VIDEO
}

enum PunchType {
  ENTRADA
  ALMUERZO_INICIO
  ALMUERZO_FIN
  SALIDA
}

// AUTO_GEOFENCE ya no se genera: el marcado real de ENTRADA/SALIDA siempre es
// una accion manual del trabajador (ver GeofenceProximityLog para el registro
// de referencia por proximidad). Se deja el valor en el enum unicamente por
// compatibilidad con TimeEntry historicos que ya lo tengan.
enum TimeEntrySource {
  MANUAL
  AUTO_GEOFENCE
}

enum Locale {
  ES
  EN
  PAP
}

enum ReminderWindow {
  MORNING
  AFTERNOON
}

enum ProjectSector {
  ORANJESTAD
  SAN_NICOLAS
  NOORD
  SANTA_CRUZ
  PARADERA
  SAVANETA
  OTRO
}

enum ProjectPropertyType {
  RESIDENCIAL
  COMERCIAL
  INDUSTRIAL
}

enum ProjectWorkType {
  INSTALACION_NUEVA
  REMODELACION
  MANTENIMIENTO
  REPARACION_EMERGENCIA
  INSPECCION
}

enum ProjectPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum InvoiceStatus {
  PENDIENTE_REVISION
  APROBADA
  DEVUELTA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  OTRO
}

enum AgendaEventType {
  REUNION
  PENDIENTE
  OTRO
}

// Secciones de la app que se pueden habilitar/deshabilitar por persona (ver
// UserFeatureAccess) — un "portón" por seccion, separado de los permisos
// finos que ya existen dentro de cada una (esos no se tocan). USUARIOS
// incluye CRUD de usuarios + mapa de equipo + horas/pago de trabajadores.
enum Feature {
  USUARIOS
  PROYECTOS
  CLIENTES
  INVENTARIO
  EVIDENCIAS
  FACTURAS
}

// Adelanto (a favor del trabajador, se resta de la liquidacion) o descuento
// (en contra, tambien se resta) — los dos restan del sueldo del periodo, la
// distincion es solo de motivo/reporte, ver SalaryAdjustment.
enum SalaryAdjustmentType {
  ADELANTO
  DESCUENTO
}

// BORRADOR: recien generada, se puede volver a generar (ej. si se cargaron
// mas marcaciones despues) sin restriccion. PAGADA: ya se le pago al
// trabajador — a partir de ahi ese userId+periodo exacto queda bloqueado
// para no duplicar el pago (ver generatePayroll en payroll.service.ts).
enum PayrollStatus {
  BORRADOR
  PAGADA
}

// ---------- Modelos ----------

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role
  phone        String?
  isActive     Boolean @default(true)
  locale       Locale  @default(ES)

  // Precio por hora del trabajador. Nullable: no todos los usuarios (ej.
  // ADMINISTRADOR/GERENTE) tienen uno, y todavía no existe el modulo de
  // nomina que lo consuma (Fase 2) — por ahora solo se captura el dato.
  hourlyRate Decimal? @db.Decimal(10, 2)

  // Tarifa de hora extra, distinta de hourlyRate. Nullable: no todos los
  // trabajadores tienen horas extra pactadas.
  overtimeHourlyRate Decimal? @db.Decimal(10, 2)

  // Datos de perfil laboral, para el perfil consolidado del trabajador —
  // todo nullable/opcional, se carga a mano por el ADMINISTRADOR/GERENTE cuando corresponda,
  // no hay valor por defecto sensato para ninguno de estos.
  hireDate         DateTime?
  specialties      String[]  @default([])
  workDaysPerWeek  Int?
  workScheduleNote String?

  // Foto de perfil, editable por el propio usuario desde /profile. Nullable:
  // la mayoria de usuarios sembrados/creados no la van a tener de entrada.
  photoUrl      String?
  photoPublicId String?

  // Ultima ubicacion conocida, capturada por el cliente durante una sesion
  // (no es rastreo continuo en segundo plano). La usa el marcado automatico
  // por geocerca para saber si el trabajador esta cerca de la oficina.
  lastKnownLatitude  Float?
  lastKnownLongitude Float?
  lastLocationAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects          Project[]              @relation("ProjectCreatedBy")
  activityAssignments      ActivityAssignment[]
  timeEntries              TimeEntry[]
  editedTimeEntries        TimeEntry[]            @relation("TimeEntryEditedBy")
  uploadedEvidences        Evidence[]             @relation("EvidenceUploadedBy")
  reviewedEvidences        Evidence[]             @relation("EvidenceReviewedBy")
  uploadedInvoices         Invoice[]              @relation("InvoiceUploadedBy")
  reviewedInvoices         Invoice[]              @relation("InvoiceReviewedBy")
  recordedPayments         Payment[]              @relation("PaymentRecordedBy")
  skippedActivities        Activity[]             @relation("ActivitySkippedBy")
  chatMessages             ChatMessage[]
  refreshTokens            RefreshToken[]
  pushSubscriptions        PushSubscription[]
  punchReminderLogs        PunchReminderLog[]
  geofenceProximityLogs    GeofenceProximityLog[]
  salaryRaises             SalaryRaise[]          @relation("SalaryRaiseForUser")
  createdSalaryRaises      SalaryRaise[]          @relation("SalaryRaiseCreatedBy")
  salaryAdjustments        SalaryAdjustment[]     @relation("SalaryAdjustmentForUser")
  createdSalaryAdjustments SalaryAdjustment[]     @relation("SalaryAdjustmentCreatedBy")
  payrollRuns              PayrollRun[]           @relation("PayrollRunForUser")
  generatedPayrollRuns     PayrollRun[]           @relation("PayrollRunGeneratedBy")
  scoreEvents              WorkerScoreEvent[]     @relation("WorkerScoreEventForUser")
  createdScoreEvents       WorkerScoreEvent[]     @relation("WorkerScoreEventCreatedBy")

  toolAssignments          ToolAssignment[]     @relation("ToolAssignmentUser")
  materialRequests         MaterialRequest[]    @relation("MaterialRequestRequestedBy")
  resolvedMaterialRequests MaterialRequest[]    @relation("MaterialRequestResolvedBy")
  toolIncidentReports      ToolIncidentReport[] @relation("ToolIncidentReportedBy")
  agendaEvents             AgendaEvent[]        @relation("AgendaEventCreatedBy")

  assignedVehicles         Vehicle[]               @relation("VehicleAssignedTo")
  recordedFuelLogs         FuelLog[]               @relation("FuelLogRecordedBy")
  reportedVehicleIncidents VehicleIncidentReport[] @relation("VehicleIncidentReportedBy")

  workerDocuments         WorkerDocument[] @relation("WorkerDocumentUser")
  uploadedWorkerDocuments WorkerDocument[] @relation("WorkerDocumentUploadedBy")

  featureAccess        UserFeatureAccess[] @relation("UserFeatureAccessUser")
  grantedFeatureAccess UserFeatureAccess[] @relation("UserFeatureAccessGrantedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Cliente real (entidad propia) al que pertenece un proyecto. Reemplaza de a
// poco a los campos sueltos ownerName/ownerPhone/ownerEmail de Project (ver
// prisma/migrate-owners-to-clients.ts para la migracion de datos de uno a
// otro) — ambos sistemas conviven mientras tanto, Project.clientId es
// nullable a proposito. onDelete: Restrict porque es dato financiero: no debe
// poder borrarse un cliente que todavia tiene proyectos vinculados.
model Client {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?
  notes String?

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANIFICADO)
  startDate   DateTime?
  endDate     DateTime?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // Información operativa del sitio de trabajo. Todo nullable a nivel de DB
  // (hay proyectos existentes sin estos datos); el formulario de creación
  // exige un subconjunto de estos campos a nivel de aplicación (ver
  // projects.validators.ts), no a nivel de schema.
  // ownerName/ownerPhone/ownerEmail: respaldo del owner en texto libre,
  // anterior al modelo Client — se mantienen hasta confirmar que la
  // migracion de datos a Client salio bien (se quitan en una ronda aparte).
  ownerName          String?
  ownerPhone         String?
  ownerEmail         String?
  // address sigue siendo util como descripcion complementaria (ej. "casa
  // azul, porton negro"), pero mapsUrl es ahora la fuente primaria de
  // ubicacion para "Como llegar" cuando esta presente.
  address            String?
  mapsUrl            String?
  sector             ProjectSector?
  accessNotes        String?
  propertyType       ProjectPropertyType?
  workType           ProjectWorkType?
  priority           ProjectPriority?     @default(MEDIA)
  electricalPlansUrl String?

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  activities       Activity[]
  invoices         Invoice[]
  payments         Payment[]
  chatMessages     ChatMessage[]
  materialRequests MaterialRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("projects")
}

model Activity {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        ActivityStatus @default(PENDIENTE)
  scheduledDate DateTime?
  completedAt   DateTime?

  // Imagen de referencia opcional que sube ADMINISTRADOR/GERENTE/SUPERVISOR al crear/editar la
  // actividad (que hay que hacer) — distinta de las evidencias fotograficas
  // que sube el trabajador (que se hizo). Nullable: la mayoria de actividades
  // no la van a tener.
  referenceImageUrl      String?
  referenceImagePublicId String?
  // Null = imagen (todo lo subido antes de esta migracion) o sin archivo.
  referenceMediaType     MediaType?

  // Se completan solo cuando status pasa a OMITIDA (ver PATCH /skip). No se
  // limpian automaticamente si despues se reprograma (vuelve a PENDIENTE) —
  // quedan como rastro de que ya se omitio una vez, aunque la UI solo los
  // muestra mientras status siga siendo OMITIDA.
  skipReason  String?
  skippedAt   DateTime?
  skippedById String?
  skippedBy   User?     @relation("ActivitySkippedBy", fields: [skippedById], references: [id])

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignments ActivityAssignment[]
  timeEntries TimeEntry[]
  evidences   Evidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("activities")
}

// Relación N:M entre Activity y User (un trabajador puede tener varias
// actividades asignadas y una actividad puede tener varios trabajadores)
model ActivityAssignment {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([activityId, userId])
  @@map("activity_assignments")
}

// Marcación de entrada/salida. Cada marcación es un registro independiente
// (tipo ENTRADA o SALIDA) con ubicación opcional.
model TimeEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  type      PunchType
  timestamp DateTime        @default(now())
  latitude  Float?
  longitude Float?
  source    TimeEntrySource @default(MANUAL)

  // Edicion auditada: originalTimestamp queda null mientras nadie la haya
  // tocado (evita duplicar el valor de "timestamp" en cada fila sin editar).
  // Al editar se copia el timestamp original aca antes de sobreescribirlo.
  originalTimestamp DateTime?
  editedById        String?
  editedBy          User?     @relation("TimeEntryEditedBy", fields: [editedById], references: [id])
  editedAt          DateTime?
  editReason        String?

  createdAt DateTime @default(now())

  @@index([userId, timestamp])
  @@map("time_entries")
}

// Registro de referencia: "el trabajador estuvo cerca de la oficina a esta
// hora", generado en segundo plano por POST /time-entries/auto-check cuando
// el trabajador esta dentro del radio configurado. NO crea ni reemplaza una
// marcacion real — el marcado de ENTRADA/SALIDA es siempre una accion manual
// del trabajador. Sirve como dato informativo para el manager cuando revisa
// las horas de un dia y el trabajador olvido marcar.
model GeofenceProximityLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  latitude       Float
  longitude      Float
  distanceMeters Float
  detectedAt     DateTime @default(now())

  @@index([userId, detectedAt])
  @@map("geofence_proximity_logs")
}

// Historial de aumentos de sueldo por hora. Cada fila es un evento inmutable
// (no se edita ni se borra) — el precio actual vive en User.hourlyRate, esto
// es solo el registro de como llego ahi. previousRate queda null si el
// usuario no tenia un precio por hora configurado antes de este aumento.
model SalaryRaise {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SalaryRaiseForUser", fields: [userId], references: [id], onDelete: Cascade)

  previousRate Decimal? @db.Decimal(10, 2)
  newRate      Decimal  @db.Decimal(10, 2)

  // Cambio de tarifa de hora extra, opcional: un mismo aumento puede tocar
  // solo la tarifa normal, o ambas a la vez con un solo motivo. Nullable
  // tambien por compatibilidad con aumentos viejos que no la tenian.
  previousOvertimeRate Decimal? @db.Decimal(10, 2)
  newOvertimeRate      Decimal? @db.Decimal(10, 2)

  reason String?

  createdById String
  createdBy   User   @relation("SalaryRaiseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("salary_raises")
}

// Adelantos y descuentos de sueldo por trabajador — base para el calculo de
// liquidacion mensual (Modulo 2.3). Cada fila es un evento inmutable (no se
// edita; ver DELETE en auth.service.ts para corregir un registro mal
// ingresado, mismo criterio que Payment). No toca ningun campo de User, a
// diferencia de SalaryRaise: es puro registro para que la liquidacion lo
// sume/reste sobre el sueldo del periodo correspondiente.
model SalaryAdjustment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SalaryAdjustmentForUser", fields: [userId], references: [id], onDelete: Cascade)

  type   SalaryAdjustmentType
  amount Decimal              @db.Decimal(10, 2)
  reason String

  // Mes/dia al que aplica el adelanto/descuento para la liquidacion, no
  // necesariamente el mismo dia en que se registro (ver createdAt).
  effectiveDate DateTime

  createdById String
  createdBy   User   @relation("SalaryAdjustmentCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, effectiveDate])
  @@map("salary_adjustments")
}

// Liquidacion mensual (Modulo 2.3): combina horas trabajadas (via
// timeEntriesService.getSummary sobre [periodStart, periodEnd)) + tarifas de
// User + SalaryAdjustment del mismo rango, en un solo snapshot inmutable —
// una vez generada, el numero no se recalcula solo aunque cambien las
// marcaciones despues (para eso se vuelve a generar, ver payroll.service.ts).
// periodStart/periodEnd son dias calendario de Aruba, ambos inclusive tal
// como los eligio el Administrador/Gerente (el service arma el rango
// [start, end) exclusivo internamente al consultar, ver arubaDayRangeUtc).
model PayrollRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PayrollRunForUser", fields: [userId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  normalMinutes   Int
  overtimeMinutes Int
  normalPay       Decimal @db.Decimal(10, 2)
  overtimePay     Decimal @db.Decimal(10, 2)
  totalAdvances   Decimal @db.Decimal(10, 2)
  totalDeductions Decimal @db.Decimal(10, 2)
  netPay          Decimal @db.Decimal(10, 2)

  status PayrollStatus @default(BORRADOR)

  generatedById String
  generatedBy   User     @relation("PayrollRunGeneratedBy", fields: [generatedById], references: [id])
  generatedAt   DateTime @default(now())

  paidAt DateTime?
  notes  String?

  @@index([userId, periodStart])
  @@map("payroll_runs")
}

// Evento de puntaje mensual (bonos/descuentos por incidentes). El puntaje de
// un mes se calcula sumando estos eventos sobre una base fija — nunca se
// decrementa un contador directo, para que quede auditable desde el origen
// en vez de un numero que alguien pudo pisar sin dejar rastro.
model WorkerScoreEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("WorkerScoreEventForUser", fields: [userId], references: [id], onDelete: Cascade)

  points Int
  reason String

  createdById String
  createdBy   User   @relation("WorkerScoreEventCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("worker_score_events")
}

model Evidence {
  id String @id @default(cuid())

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])

  imageUrl      String
  // public_id de Cloudinary — hace falta para poder borrar el archivo despues
  // (cloudinary.uploader.destroy). Nullable: evidencias sembradas antes de la
  // migracion a Cloudinary no lo tienen.
  imagePublicId String?
  // Null = imagen (evidencias sembradas antes de esta migracion).
  mediaType     MediaType?
  description   String?
  status        EvidenceStatus @default(PENDIENTE)

  reviewedById  String?
  reviewedBy    User?     @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
  @@index([status])
  @@map("evidences")
}

// Factura en PDF de un proyecto. Flujo: Supervisor sube -> Jefe aprueba o
// devuelve con comentario -> si fue devuelta, Supervisor resube el PDF
// corregido (reemplaza el archivo, vuelve a PENDIENTE_REVISION). reviewComment
// no acumula historial: guarda solo el motivo del ciclo de devolucion mas
// reciente, se limpia al resubir.
model Invoice {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("InvoiceUploadedBy", fields: [uploadedById], references: [id])

  fileUrl      String
  // public_id de Cloudinary (resource_type "raw") — hace falta para poder
  // borrar el archivo viejo al resubir una correccion.
  filePublicId String

  status InvoiceStatus @default(PENDIENTE_REVISION)

  reviewComment String?
  reviewedById  String?
  reviewedBy    User?     @relation("InvoiceReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("invoices")
}

// Registro de un pago recibido del cliente de un proyecto. Solo registro y
// consulta por ahora — sin calculo de saldo/deuda (no hay un "monto total"
// del proyecto contra el cual comparar todavia). clientId no se duplica aca:
// se deriva siempre de project.client. Sin edicion auditada: si un registro
// esta mal, se borra (DELETE, solo Jefe) y se vuelve a crear.
model Payment {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  // Fecha en que ocurrio el pago, distinta de createdAt: el pago pudo haber
  // pasado antes de registrarse en el sistema (ej. un cheque cobrado la
  // semana pasada que recien ahora se carga).
  paymentDate DateTime
  method      PaymentMethod
  reference   String?
  notes       String?

  recordedById String
  recordedBy   User   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([paymentDate])
  @@map("payments")
}

// Chat en tiempo real por proyecto (Socket.IO), visible para Jefe/Supervisor
// y los trabajadores asignados a alguna actividad de ese proyecto (mismo
// criterio de visibilidad que Project.visibilityWhere). Sin edicion/borrado
// de mensajes por ahora — es un canal de comunicacion, no un registro
// auditable como Payment.
model ChatMessage {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation(fields: [senderId], references: [id])

  content String

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@map("chat_messages")
}

// Fila unica (singleton, id fijo = 1) con la configuracion de la empresa para
// marcado automatico por geocerca. officeLatitude/officeLongitude quedan null
// hasta que el ADMINISTRADOR/GERENTE configure la ubicacion real desde /api/settings — no hay
// un default sensato para coordenadas de un sitio especifico, a diferencia
// del radio y las ventanas horarias.
model CompanySettings {
  id Int @id @default(1)

  officeLatitude     Float?
  officeLongitude    Float?
  officeRadiusMeters Int    @default(125)

  morningWindowStart String @default("06:30")
  morningWindowEnd   String @default("07:30")

  afternoonWindowStart String @default("16:30")
  afternoonWindowEnd   String @default("18:00")

  // Umbral en minutos para calcular horas extra (ver time-entries.service.ts
  // getSummary/getTodayStatus): lo que exceda esto en un dia cuenta como
  // overtimeMinutes en vez de normalMinutes. Default 480 = 8 horas.
  standardDailyMinutes Int @default(480)

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// Suscripcion push (Web Push API) de un dispositivo/navegador concreto. Un
// mismo usuario puede tener varias (distintos dispositivos); "endpoint" es
// unico por navegador/dispositivo, asi que volver a suscribirse actualiza la
// fila existente en vez de duplicarla.
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Registra que ya se envio el recordatorio de marcado de una ventana
// (mañana/tarde) en un dia especifico, para que el job que corre cada 5
// minutos no lo repita. "date" es el dia calendario en hora de Aruba, no un
// timestamp.
model PunchReminderLog {
  id     String         @id @default(cuid())
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  window ReminderWindow
  date   DateTime       @db.Date
  sentAt DateTime       @default(now())

  @@unique([userId, window, date])
  @@map("punch_reminder_logs")
}

// Catalogo de inventario (herramientas y materiales), administrado por
// MERCADERISTA. Un mismo modelo para ambos tipos (en vez de dos tablas
// separadas) porque comparten todos los campos — solo cambia el significado
// operativo (una herramienta se asigna y se devuelve, un material se pide y
// se consume).
model InventoryItem {
  id   String            @id @default(cuid())
  name String
  type InventoryItemType

  // Unidad de medida en texto libre (ej. "unidad", "metros", "cajas") — no un
  // enum: el catalogo de materiales electricos es demasiado variado para
  // cerrarlo a una lista fija.
  unit String

  stockQuantity Int @default(0)

  // Nullable: la alerta de stock bajo es una funcionalidad futura, todavia no
  // hay UI que la consuma — se captura el dato cuando existe para no tener
  // que migrar de nuevo despues.
  lowStockThreshold Int?
  notes             String?

  toolAssignments  ToolAssignment[]
  materialRequests MaterialRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("inventory_items")
}

// Herramienta a cargo de un trabajador. Un trabajador puede tener varias
// simultaneamente (sin @@unique de por medio) — el "estado actual" de una
// herramienta puntual se deriva de si tiene alguna ToolAssignment con
// returnedAt null.
model ToolAssignment {
  id String @id @default(cuid())

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  userId String
  user   User   @relation("ToolAssignmentUser", fields: [userId], references: [id])

  assignedAt DateTime @default(now())

  // Null = todavia la tiene asignada; se completa al devolverla.
  returnedAt DateTime?

  // Nota de estado al momento de asignar (ej. "usada, con rayones") — una
  // foto del momento de la entrega, no el estado actual.
  condition String?

  incidentReports ToolIncidentReport[]

  @@index([itemId])
  @@index([userId])
  @@map("tool_assignments")
}

// Pedido de material (o herramienta) hecho por un trabajador o supervisor.
model MaterialRequest {
  id String @id @default(cuid())

  requestedById String
  requestedBy   User   @relation("MaterialRequestRequestedBy", fields: [requestedById], references: [id])

  // Nullable: puede pedirse algo que todavia no existe en el catalogo, via
  // texto libre (itemNameFreeText) en vez de una referencia real. onDelete
  // SetNull porque si el item se borra despues, el pedido sigue siendo un
  // registro historico valido (con itemNameFreeText y reason como respaldo).
  itemId           String?
  item             InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemNameFreeText String?

  // Nullable: permite solicitudes generales no atadas a un proyecto puntual
  // (ej. insumos de bodega). onDelete SetNull por el mismo motivo que itemId
  // — si el proyecto se borra despues, la solicitud sigue siendo un registro
  // historico valido.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  quantity Int
  reason   String

  status MaterialRequestStatus @default(PENDIENTE)

  resolvedById   String?
  resolvedBy     User?     @relation("MaterialRequestResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())

  @@index([requestedById])
  @@index([itemId])
  @@index([projectId])
  @@index([status])
  @@map("material_requests")
}

// Reporte de que una herramienta a cargo de alguien se dañó o se perdió.
model ToolIncidentReport {
  id String @id @default(cuid())

  toolAssignmentId String
  toolAssignment   ToolAssignment @relation(fields: [toolAssignmentId], references: [id], onDelete: Cascade)

  reportedById String
  reportedBy   User   @relation("ToolIncidentReportedBy", fields: [reportedById], references: [id])

  type        ToolIncidentType
  description String

  reportedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  @@index([toolAssignmentId])
  @@map("tool_incident_reports")
}

// Flota de la empresa (Fase 3, Modulo 3.3) — mismo patron de acceso que
// ToolAssignment/ToolIncidentReport: un trabajador con un vehiculo a cargo
// puede registrar tanqueadas/incidentes sobre el (ver vehicles.service.ts),
// la gestion completa (CRUD, cola de revision) es de Administrador/Gerente/
// Supervisor. A diferencia de InventoryItem, la asignacion no tiene su
// propio modelo de historial — assignedToId vive directo en el vehiculo,
// un vehiculo solo tiene un responsable principal a la vez.
model Vehicle {
  id    String @id @default(cuid())
  plate String @unique

  brand String
  model String
  year  Int

  // VIN u otro numero de identificacion — opcional, no todos los vehiculos
  // viejos de la flota lo tienen cargado.
  identificationNumber String?

  // Quien lo tiene a cargo principalmente. Nullable: un vehiculo puede estar
  // sin asignar (recien comprado, o de uso compartido en oficina).
  assignedToId String?
  assignedTo   User?   @relation("VehicleAssignedTo", fields: [assignedToId], references: [id])

  status VehicleStatus @default(ACTIVO)
  notes  String?

  fuelLogs        FuelLog[]
  incidentReports VehicleIncidentReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("vehicles")
}

// Tanqueada — puro registro de gasto de combustible, sin edicion (si esta
// mal, se corrige por gestion directo en la base, no hay UI/ruta de
// edicion/borrado en esta primera version, mismo alcance que el pedido).
model FuelLog {
  id String @id @default(cuid())

  vehicleId String
  // Restrict a proposito, mismo criterio que ToolAssignment.item: nunca
  // perder el historial de gasto de combustible al borrar un vehiculo.
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  date DateTime
  cost Decimal  @db.Decimal(10, 2)

  // Nullable: no todos los recibos/estaciones traen litros exactos.
  liters Decimal? @db.Decimal(10, 2)

  odometerReading Int?

  recordedById String
  recordedBy   User   @relation("FuelLogRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([vehicleId, date])
  @@map("fuel_logs")
}

// Daño, mantenimiento o reparacion reportado sobre un vehiculo — mismo
// espiritu que ToolIncidentReport, pero con foto opcional y costo opcional
// (un ToolIncidentReport no tiene ninguno de los dos).
model VehicleIncidentReport {
  id String @id @default(cuid())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  type        VehicleIncidentType
  description String

  cost Decimal? @db.Decimal(10, 2)

  // Opcional: no todo incidente tiene foto (ej. un mantenimiento programado
  // sin nada que fotografiar) — mismo patron de Cloudinary que el resto de
  // la app (ver config/storage.ts).
  photoUrl      String?
  photoPublicId String?

  reportedById String
  reportedBy   User   @relation("VehicleIncidentReportedBy", fields: [reportedById], references: [id])

  reportedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  @@index([vehicleId])
  @@map("vehicle_incident_reports")
}

// Agenda compartida de Jefe/Supervisor: reuniones y pendientes generales de
// gestion, distinta de la programacion de actividades de proyecto
// (Activity.scheduledDate). Es deliberadamente compartida, no privada por
// persona — cualquier Jefe/Supervisor ve todos los eventos (ver
// agenda-events.service.ts), createdById solo determina quien puede
// editar/borrar un evento ajeno (el Jefe siempre puede, el creador siempre
// puede el suyo).
model AgendaEvent {
  id          String  @id @default(cuid())
  title       String
  description String?

  startAt DateTime
  // Nullable: no todo evento tiene una hora de fin definida de antemano
  // (ej. un "pendiente" sin horario fijo, a diferencia de una reunion).
  endAt   DateTime?

  type AgendaEventType

  createdById String
  createdBy   User   @relation("AgendaEventCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
  @@map("agenda_events")
}

// Documentos del trabajador (cedula, certificados, etc). userId es de quien
// es el documento; uploadedById es quien lo subio (puede ser el mismo
// trabajador o un Administrador/Gerente/Supervisor en su nombre) — el
// borrado usa uploadedById, no userId (ver auth.service.ts: ADMINISTRADOR/
// GERENTE siempre pueden, o quien subio el documento originalmente).
model WorkerDocument {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation("WorkerDocumentUser", fields: [userId], references: [id])
  label        String
  fileUrl      String
  filePublicId String

  uploadedById String
  uploadedBy   User   @relation("WorkerDocumentUploadedBy", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@map("worker_documents")
}

// Override explicito de acceso a una seccion (Feature) para un usuario
// puntual — un "portón" por seccion, separado de los permisos finos que ya
// existen dentro de cada una (esos no se tocan). Si no hay fila para
// (userId, feature), se usa el default por rol (ver
// permissions.service.ts ROLE_FEATURE_DEFAULTS). GERENTE ignora cualquier
// override y siempre tiene acceso (ver requireFeature.middleware.ts), para
// que nunca pueda quedar bloqueado a si mismo sin nadie que pueda
// revertirlo — es deliberado, no un bug.
model UserFeatureAccess {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation("UserFeatureAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  feature Feature
  granted Boolean

  grantedById String
  grantedBy   User   @relation("UserFeatureAccessGrantedBy", fields: [grantedById], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([userId, feature])
  @@map("user_feature_access")
}
