// Schema Prisma - Sistema de Gestión Empresarial (Empresa Eléctrica)
// Fase 1: Usuarios/roles, marcación de horas, proyectos/actividades, evidencias fotográficas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  JEFE
  SUPERVISOR
  TRABAJADOR_CAMPO
}

enum ProjectStatus {
  PLANIFICADO
  EN_PROGRESO
  PAUSADO
  COMPLETADO
  CANCELADO
}

enum ActivityStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

enum EvidenceStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum PunchType {
  ENTRADA
  SALIDA
}

// AUTO_GEOFENCE ya no se genera: el marcado real de ENTRADA/SALIDA siempre es
// una accion manual del trabajador (ver GeofenceProximityLog para el registro
// de referencia por proximidad). Se deja el valor en el enum unicamente por
// compatibilidad con TimeEntry historicos que ya lo tengan.
enum TimeEntrySource {
  MANUAL
  AUTO_GEOFENCE
}

enum Locale {
  ES
  EN
  PAP
}

enum ReminderWindow {
  MORNING
  AFTERNOON
}

enum ProjectSector {
  ORANJESTAD
  SAN_NICOLAS
  NOORD
  SANTA_CRUZ
  PARADERA
  SAVANETA
  OTRO
}

enum ProjectPropertyType {
  RESIDENCIAL
  COMERCIAL
  INDUSTRIAL
}

enum ProjectWorkType {
  INSTALACION_NUEVA
  REMODELACION
  MANTENIMIENTO
  REPARACION_EMERGENCIA
  INSPECCION
}

enum ProjectPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum InvoiceStatus {
  PENDIENTE_REVISION
  APROBADA
  DEVUELTA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  OTRO
}

// ---------- Modelos ----------

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         Role
  phone        String?
  isActive     Boolean @default(true)
  locale       Locale  @default(ES)

  // Precio por hora del trabajador. Nullable: no todos los usuarios (ej. JEFE)
  // tienen uno, y todavía no existe el modulo de nomina que lo consuma (Fase 2) —
  // por ahora solo se captura el dato.
  hourlyRate Decimal? @db.Decimal(10, 2)

  // Tarifa de hora extra, distinta de hourlyRate. Nullable: no todos los
  // trabajadores tienen horas extra pactadas.
  overtimeHourlyRate Decimal? @db.Decimal(10, 2)

  // Datos de perfil laboral, para el perfil consolidado del trabajador —
  // todo nullable/opcional, se carga a mano por el JEFE cuando corresponda,
  // no hay valor por defecto sensato para ninguno de estos.
  hireDate         DateTime?
  specialties      String[]  @default([])
  workDaysPerWeek  Int?
  workScheduleNote String?

  // Foto de perfil, editable por el propio usuario desde /profile. Nullable:
  // la mayoria de usuarios sembrados/creados no la van a tener de entrada.
  photoUrl      String?
  photoPublicId String?

  // Ultima ubicacion conocida, capturada por el cliente durante una sesion
  // (no es rastreo continuo en segundo plano). La usa el marcado automatico
  // por geocerca para saber si el trabajador esta cerca de la oficina.
  lastKnownLatitude  Float?
  lastKnownLongitude Float?
  lastLocationAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects     Project[]            @relation("ProjectCreatedBy")
  activityAssignments ActivityAssignment[]
  timeEntries         TimeEntry[]
  editedTimeEntries   TimeEntry[]          @relation("TimeEntryEditedBy")
  uploadedEvidences   Evidence[]           @relation("EvidenceUploadedBy")
  reviewedEvidences   Evidence[]           @relation("EvidenceReviewedBy")
  uploadedInvoices    Invoice[]            @relation("InvoiceUploadedBy")
  reviewedInvoices    Invoice[]            @relation("InvoiceReviewedBy")
  recordedPayments    Payment[]            @relation("PaymentRecordedBy")
  refreshTokens       RefreshToken[]
  pushSubscriptions   PushSubscription[]
  punchReminderLogs   PunchReminderLog[]
  geofenceProximityLogs GeofenceProximityLog[]
  salaryRaises        SalaryRaise[] @relation("SalaryRaiseForUser")
  createdSalaryRaises SalaryRaise[] @relation("SalaryRaiseCreatedBy")
  scoreEvents        WorkerScoreEvent[] @relation("WorkerScoreEventForUser")
  createdScoreEvents WorkerScoreEvent[] @relation("WorkerScoreEventCreatedBy")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Cliente real (entidad propia) al que pertenece un proyecto. Reemplaza de a
// poco a los campos sueltos ownerName/ownerPhone/ownerEmail de Project (ver
// prisma/migrate-owners-to-clients.ts para la migracion de datos de uno a
// otro) — ambos sistemas conviven mientras tanto, Project.clientId es
// nullable a proposito. onDelete: Restrict porque es dato financiero: no debe
// poder borrarse un cliente que todavia tiene proyectos vinculados.
model Client {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?
  notes String?

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(PLANIFICADO)
  startDate   DateTime?
  endDate     DateTime?

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict)

  // Información operativa del sitio de trabajo. Todo nullable a nivel de DB
  // (hay proyectos existentes sin estos datos); el formulario de creación
  // exige un subconjunto de estos campos a nivel de aplicación (ver
  // projects.validators.ts), no a nivel de schema.
  // ownerName/ownerPhone/ownerEmail: respaldo del owner en texto libre,
  // anterior al modelo Client — se mantienen hasta confirmar que la
  // migracion de datos a Client salio bien (se quitan en una ronda aparte).
  ownerName          String?
  ownerPhone         String?
  ownerEmail         String?
  address            String?
  sector             ProjectSector?
  accessNotes        String?
  propertyType       ProjectPropertyType?
  workType           ProjectWorkType?
  priority           ProjectPriority?     @default(MEDIA)
  electricalPlansUrl String?

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  activities Activity[]
  invoices   Invoice[]
  payments   Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("projects")
}

model Activity {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        ActivityStatus @default(PENDIENTE)
  scheduledDate DateTime?
  completedAt   DateTime?

  // Imagen de referencia opcional que sube JEFE/SUPERVISOR al crear/editar la
  // actividad (que hay que hacer) — distinta de las evidencias fotograficas
  // que sube el trabajador (que se hizo). Nullable: la mayoria de actividades
  // no la van a tener.
  referenceImageUrl      String?
  referenceImagePublicId String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignments ActivityAssignment[]
  timeEntries TimeEntry[]
  evidences   Evidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("activities")
}

// Relación N:M entre Activity y User (un trabajador puede tener varias
// actividades asignadas y una actividad puede tener varios trabajadores)
model ActivityAssignment {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([activityId, userId])
  @@map("activity_assignments")
}

// Marcación de entrada/salida. Cada marcación es un registro independiente
// (tipo ENTRADA o SALIDA) con ubicación opcional.
model TimeEntry {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  type      PunchType
  timestamp DateTime  @default(now())
  latitude  Float?
  longitude Float?
  source    TimeEntrySource @default(MANUAL)

  // Edicion auditada: originalTimestamp queda null mientras nadie la haya
  // tocado (evita duplicar el valor de "timestamp" en cada fila sin editar).
  // Al editar se copia el timestamp original aca antes de sobreescribirlo.
  originalTimestamp DateTime?
  editedById        String?
  editedBy          User?     @relation("TimeEntryEditedBy", fields: [editedById], references: [id])
  editedAt          DateTime?
  editReason        String?

  createdAt DateTime @default(now())

  @@index([userId, timestamp])
  @@map("time_entries")
}

// Registro de referencia: "el trabajador estuvo cerca de la oficina a esta
// hora", generado en segundo plano por POST /time-entries/auto-check cuando
// el trabajador esta dentro del radio configurado. NO crea ni reemplaza una
// marcacion real — el marcado de ENTRADA/SALIDA es siempre una accion manual
// del trabajador. Sirve como dato informativo para el manager cuando revisa
// las horas de un dia y el trabajador olvido marcar.
model GeofenceProximityLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  latitude       Float
  longitude      Float
  distanceMeters Float
  detectedAt     DateTime @default(now())

  @@index([userId, detectedAt])
  @@map("geofence_proximity_logs")
}

// Historial de aumentos de sueldo por hora. Cada fila es un evento inmutable
// (no se edita ni se borra) — el precio actual vive en User.hourlyRate, esto
// es solo el registro de como llego ahi. previousRate queda null si el
// usuario no tenia un precio por hora configurado antes de este aumento.
model SalaryRaise {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SalaryRaiseForUser", fields: [userId], references: [id], onDelete: Cascade)

  previousRate Decimal? @db.Decimal(10, 2)
  newRate      Decimal  @db.Decimal(10, 2)
  reason       String?

  createdById String
  createdBy   User   @relation("SalaryRaiseCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("salary_raises")
}

// Evento de puntaje mensual (bonos/descuentos por incidentes). El puntaje de
// un mes se calcula sumando estos eventos sobre una base fija — nunca se
// decrementa un contador directo, para que quede auditable desde el origen
// en vez de un numero que alguien pudo pisar sin dejar rastro.
model WorkerScoreEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("WorkerScoreEventForUser", fields: [userId], references: [id], onDelete: Cascade)

  points Int
  reason String

  createdById String
  createdBy   User   @relation("WorkerScoreEventCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("worker_score_events")
}

model Evidence {
  id String @id @default(cuid())

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id])

  imageUrl    String
  // public_id de Cloudinary — hace falta para poder borrar el archivo despues
  // (cloudinary.uploader.destroy). Nullable: evidencias sembradas antes de la
  // migracion a Cloudinary no lo tienen.
  imagePublicId String?
  description   String?
  status        EvidenceStatus @default(PENDIENTE)

  reviewedById   String?
  reviewedBy     User?     @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewComment  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activityId])
  @@index([status])
  @@map("evidences")
}

// Factura en PDF de un proyecto. Flujo: Supervisor sube -> Jefe aprueba o
// devuelve con comentario -> si fue devuelta, Supervisor resube el PDF
// corregido (reemplaza el archivo, vuelve a PENDIENTE_REVISION). reviewComment
// no acumula historial: guarda solo el motivo del ciclo de devolucion mas
// reciente, se limpia al resubir.
model Invoice {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation("InvoiceUploadedBy", fields: [uploadedById], references: [id])

  fileUrl String
  // public_id de Cloudinary (resource_type "raw") — hace falta para poder
  // borrar el archivo viejo al resubir una correccion.
  filePublicId String

  status InvoiceStatus @default(PENDIENTE_REVISION)

  reviewComment String?
  reviewedById  String?
  reviewedBy    User?     @relation("InvoiceReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("invoices")
}

// Registro de un pago recibido del cliente de un proyecto. Solo registro y
// consulta por ahora — sin calculo de saldo/deuda (no hay un "monto total"
// del proyecto contra el cual comparar todavia). clientId no se duplica aca:
// se deriva siempre de project.client. Sin edicion auditada: si un registro
// esta mal, se borra (DELETE, solo Jefe) y se vuelve a crear.
model Payment {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(10, 2)

  // Fecha en que ocurrio el pago, distinta de createdAt: el pago pudo haber
  // pasado antes de registrarse en el sistema (ej. un cheque cobrado la
  // semana pasada que recien ahora se carga).
  paymentDate DateTime
  method      PaymentMethod
  reference   String?
  notes       String?

  recordedById String
  recordedBy   User   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([paymentDate])
  @@map("payments")
}

// Fila unica (singleton, id fijo = 1) con la configuracion de la empresa para
// marcado automatico por geocerca. officeLatitude/officeLongitude quedan null
// hasta que el JEFE configure la ubicacion real desde /api/settings — no hay
// un default sensato para coordenadas de un sitio especifico, a diferencia
// del radio y las ventanas horarias.
model CompanySettings {
  id Int @id @default(1)

  officeLatitude     Float?
  officeLongitude    Float?
  officeRadiusMeters Int    @default(125)

  morningWindowStart String @default("06:30")
  morningWindowEnd   String @default("07:30")

  afternoonWindowStart String @default("16:30")
  afternoonWindowEnd   String @default("18:00")

  updatedAt DateTime @updatedAt

  @@map("company_settings")
}

// Suscripcion push (Web Push API) de un dispositivo/navegador concreto. Un
// mismo usuario puede tener varias (distintos dispositivos); "endpoint" es
// unico por navegador/dispositivo, asi que volver a suscribirse actualiza la
// fila existente en vez de duplicarla.
model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// Registra que ya se envio el recordatorio de marcado de una ventana
// (mañana/tarde) en un dia especifico, para que el job que corre cada 5
// minutos no lo repita. "date" es el dia calendario en hora de Aruba, no un
// timestamp.
model PunchReminderLog {
  id     String         @id @default(cuid())
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  window ReminderWindow
  date   DateTime       @db.Date
  sentAt DateTime       @default(now())

  @@unique([userId, window, date])
  @@map("punch_reminder_logs")
}
