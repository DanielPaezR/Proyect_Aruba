NODE_ENV=development
PORT=4000

# Desarrollo local: apunta al Postgres 16 de docker-compose.yml (docker compose up -d).
# Puerto 5433 en el host (no 5432) para no chocar con instalaciones nativas de Postgres.
DATABASE_URL="postgresql://app:app_password@localhost:5433/app_dev?schema=public"

# Producción (Railway/Neon): Railway inyecta su propia DATABASE_URL si usas su
# plugin de Postgres. Si usas Neon en producción, agrega ?sslmode=require, ej:
# DATABASE_URL="postgresql://usuario:password@ep-xxxx.neon.tech/nombre_bd?sslmode=require"

# Secretos JWT: usar valores largos y aleatorios distintos entre sí
JWT_ACCESS_SECRET="cambia-este-secreto-de-acceso"
JWT_REFRESH_SECRET="cambia-este-secreto-de-refresco"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Origen permitido para CORS (URL del cliente Vite)
CORS_ORIGIN=http://localhost:5173

# Usuarios de prueba (uno por rol) creados por `npm run prisma:seed`
SEED_JEFE_EMAIL=jefe@empresa.com
SEED_JEFE_PASSWORD=CambiarEsta123!
SEED_SUPERVISOR_EMAIL=supervisor@empresa.com
SEED_SUPERVISOR_PASSWORD=CambiarEsta123!
SEED_WORKER_EMAIL=trabajador@empresa.com
SEED_WORKER_PASSWORD=CambiarEsta123!
