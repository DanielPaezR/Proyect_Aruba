VITE_API_URL=http://localhost:4000

# Clave publica VAPID (no es secreta, se genera junto con VAPID_PRIVATE_KEY en
# server/.env vía `npx web-push generate-vapid-keys`) — debe ser exactamente
# el mismo valor que VAPID_PUBLIC_KEY del servidor.
VITE_VAPID_PUBLIC_KEY="cambia-esta-clave-publica-vapid"
